# Copy to .env and fill in. Do not commit .env.
# Docker: docker run --rm -p 8080:8080 --env-file .env gaming-web-app:local

SECRET_KEY=change-me

# Option A: one URL (recommended for Docker / Cloud Run)
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname?ssl_disabled=true

# Option B: discrete MySQL settings (MYSQL_PORT defaults to 3306 if omitted)
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=

MONGO_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/auth/google/callback

STEAM_API_KEY=
